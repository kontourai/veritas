{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veritas.dev/schemas/veritas-change-plan.schema.json",
  "title": "Veritas ChangePlan Resource",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec", "status"],
  "properties": {
    "apiVersion": { "const": "veritas.kontour.ai/v1alpha1" },
    "kind": { "const": "ChangePlan" },
    "metadata": { "$ref": "veritas-repo-standards-resource.schema.json#/properties/metadata" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files"],
      "properties": { "files": { "type": "array", "items": { "type": "string" } } }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "executed", "files", "affectedWorkAreas", "unmatchedFiles", "uncoveredPathPolicy", "evidenceChecks", "guidance", "conditions"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "executed": { "const": false },
        "files": { "type": "array", "items": { "type": "string" } },
        "affectedWorkAreas": { "type": "array", "items": { "type": "string" } },
        "unmatchedFiles": { "type": "array", "items": { "type": "string" } },
        "uncoveredPathPolicy": { "type": "string" },
        "evidenceChecks": { "type": "array", "items": { "type": "object", "required": ["id", "required"], "properties": { "id": { "type": "string" }, "required": { "type": "boolean" } } } },
        "guidance": { "type": "array", "items": { "type": "object", "required": ["id", "enforcementLevel", "files"] } },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "status", "reason", "message"],
            "properties": {
              "type": { "const": "ChecksExecuted" },
              "status": { "const": "False" },
              "reason": { "const": "PlanningOnly" },
              "message": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
