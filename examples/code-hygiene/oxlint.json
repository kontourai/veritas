{
  "jsPlugins": [
    "@kontourai/veritas/hygiene/oxlint"
  ],
  "categories": {
    "correctness": "off"
  },
  "rules": {
    "repo-hygiene/require-suppression-reason": "error",
    "repo-hygiene/no-low-value-comments": "warn"
  },
  "overrides": [
    {
      "files": [
        "**/*.unit.test.{js,mjs,ts,tsx}"
      ],
      "rules": {
        "repo-hygiene/deterministic-unit-tests": "error"
      }
    }
  ]
}
