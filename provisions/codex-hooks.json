{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "VERITAS_ROOT=\"$(git rev-parse --show-toplevel 2>/dev/null)\"; VERITAS_BIN=; VERITAS_FOUND=; VERITAS_DIR=\"$(pwd -P 2>/dev/null)\"; while :; do case \"$VERITAS_DIR\" in /*) ;; *) break;; esac; if [ -z \"$VERITAS_FOUND\" ] && [ -f \"$VERITAS_DIR/node_modules/@kontourai/veritas/bin/veritas.mjs\" ]; then VERITAS_FOUND=\"$VERITAS_DIR/node_modules/@kontourai/veritas/bin/veritas.mjs\"; fi; if [ -n \"$VERITAS_ROOT\" ] && [ \"$VERITAS_DIR\" -ef \"$VERITAS_ROOT\" ]; then VERITAS_BIN=\"$VERITAS_FOUND\"; break; fi; if [ \"$VERITAS_DIR\" = / ]; then break; fi; VERITAS_DIR=\"${VERITAS_DIR%/*}\"; [ -n \"$VERITAS_DIR\" ] || VERITAS_DIR=/; done; if [ -n \"$VERITAS_BIN\" ]; then node \"$VERITAS_BIN\" hooks codex pre-tool-use; else npx --no @kontourai/veritas hooks codex pre-tool-use; fi",
            "commandWindows": "node -e \"eval(Buffer.from('','base64').toString())\" hooks codex pre-tool-use; exit $LASTEXITCODE",
            "statusMessage": "Loading Veritas guidance for edited files",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
