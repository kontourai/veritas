{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "npx --no @kontourai/veritas hooks codex pre-tool-use",
            "statusMessage": "Loading Veritas guidance for edited files",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
